{
  "name": "@apilens/cli",
  "version": "0.1.0",
  "description": "ApiLens CLI: find frontend code broken by backend API changes, check frontend code against the real API",
  "keywords": [
    "apilens",
    "api",
    "breaking-changes",
    "spring-boot",
    "typescript",
    "ci",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Heonjin Jeong",
  "homepage": "https://github.com/heonjinjeong/api-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heonjinjeong/api-lens.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/heonjinjeong/api-lens/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "apilens": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@apilens/ai-anthropic": "^0.1.0",
    "@apilens/core": "^0.1.0",
    "@apilens/extractor-java": "^0.1.0",
    "@apilens/extractor-typescript": "^0.1.0",
    "commander": "^15.0.0"
  }
}
